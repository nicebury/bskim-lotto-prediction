# frontend/.env_frontend 의 템플릿.
#   cp env.sample .env_frontend
#
# ⚠ Next.js 는 이 파일명을 자동으로 읽지 않는다(.env / .env.local /
#   .env.development / .env.production 만 읽는다). next.config.ts 최상단에서
#     import { config } from 'dotenv'; config({ path: '.env_frontend' })
#   로 명시 로드해야 한다. 빼먹으면 전부 undefined 가 되고 에러도 안 난다.
#   명세: docs/wiki/10-contracts/env-vars.md
#
# ⚠ NEXT_PUBLIC_ 접두어가 붙은 값은 빌드 시 브라우저 번들에 문자열로 박힌다.
#   누구나 볼 수 있다. 비밀값을 절대 넣지 않는다.

# ── 백엔드 주소 ────────────────────────────────────────
API_BASE_URL=http://localhost:8005              # 서버 컴포넌트용 (내부망)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8005  # 브라우저용 (공개)

# ── 사이트 ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://<도메인>            # TODO: 도메인 미확정
NEXT_PUBLIC_SITE_NAME=행운상자                   # 사이트명 단일 출처. 하드코딩 금지

# 문의·개인정보 보호책임자 연락처. /contact · /privacy 에 노출된다.
# 애드센스 심사는 연락 수단이 있는지를 본다. 비어 있으면 문의 페이지가 안내 문구만 보여준다.
# ⚠ 공개되는 값이다. 개인 메일이 아니라 서비스용 주소를 쓰는 편이 좋다.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── 애널리틱스 ─────────────────────────────────────────
# 비어 있으면 해당 스크립트를 렌더링하지 않는다.
NEXT_PUBLIC_GA_ID=                              # G-XXXXXXXXXX
NEXT_PUBLIC_NAVER_ANALYTICS_ID=

# ── 검색엔진 소유확인 (메타태그로 주입) ──────────────────
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# ── 애드센스 ───────────────────────────────────────────
# 승인 전에는 둘 다 비워 둔다. 비어 있으면 광고 컴포넌트도 로더도 렌더링되지 않고,
# /ads.txt 는 404 를 낸다(자리표시자를 내보내면 크롤러가 '잘못된 ads.txt' 로 기록한다).
#
# 퍼블리셔 ID. 형식은 ca-pub-0000000000000000 (16자리).
# /ads.txt 에 쓰는 pub-... 값은 여기서 자동으로 파생되므로 따로 적지 않는다.
NEXT_PUBLIC_ADSENSE_CLIENT=

# 광고 자리별 실제 슬롯 ID. '이름=숫자' 를 쉼표로 잇는다.
#
#   NEXT_PUBLIC_ADSENSE_SLOTS=home-mid=1234567890,lotto-mid=2345678901
#
# ⚠ 숫자 ID 는 승인 후 애드센스 대시보드에서 '광고 단위' 를 만들어야 발급된다.
#   코드가 쓰는 이름(왼쪽)은 아래 여섯 개다. 아직 안 만든 자리는 빼도 되고,
#   그 자리의 광고만 나오지 않는다.
#
#     home-mid          홈 중간
#     lotto-mid         /lotto 중간
#     recommend-bottom  /lotto/recommend 하단
#     round-detail      회차 상세
#     news-bottom       /news 하단
#     video-detail      영상 상세
#     playground-list   번호놀이터 목록
#
# ⚠ 이름을 그대로 두고 숫자를 넣지 않으면 광고가 한 개도 나오지 않는다.
#   애드센스는 사람이 읽는 이름을 알아보지 못한다.
NEXT_PUBLIC_ADSENSE_SLOTS=

# ── 무료 이미지 (Pexels) ───────────────────────────────
# 상세페이지(가이드 등) 이미지를 빌드/개발 시점에 골라 frontend/public 에
# 내려받아 커밋하는 '빌드타임 큐레이션' 용도. 런타임 브라우저에서 호출하지 않는다.
# ⚠ NEXT_PUBLIC_ 접두어를 붙이지 않는다 — API 키는 번들에 노출되면 안 된다.
#   서버(빌드 스크립트/서버 컴포넌트)에서만 읽는다.
# 명세·저작권 취급: docs/wiki/90-external/pexels-image-usage.md
PEXELS_API_KEY=

