# worker/.env_worker 의 템플릿.
#   cp env.sample .env_worker
# .env_worker 는 커밋하지 않는다. 명세: docs/wiki/10-contracts/env-vars.md
# 가상환경은 uv 가 관리한다 — uv sync / uv run / uv add. sudo 로 실행하지 않는다.

# ── Postgres (쓰기 롤) ──────────────────────────────────
# 개발 DB: WSL Docker 컨테이너 bskim-dev-pg18 (postgres:18)
PG_HOST=localhost
PG_PORT=5179                   # 컨테이너 5432 → 호스트 5179
PG_DB=prod_db                  # 이미 존재하는 DB. 소유자는 prod_user
PG_USER=app_writer
PG_PASSWORD=                   # worker/scripts/init_roles.sql 로 만든 비번

# ── 잡 스케줄 (KST). APScheduler CronTrigger 문법 ────────
# 코드에 박지 않는다. 추첨 시각이나 API 쿼터가 바뀌면 여기만 고친다.
#
# 여러 크론을 `;` 로 잇는다 → OrTrigger 로 합쳐진다. 잡은 여전히 하나다.
# 추첨 방송은 20:35 시작이고 번호 추첨이 끝나는 시각이 회차마다 다르다.
# 먼저 결과가 보이는 실행이 가져가고, 나머지는 0건 성공으로 끝난다.
#
# ★ 요일은 반드시 이름(sat)으로 쓴다. APScheduler 는 요일 숫자를 0=월…6=일 로 읽어
#   표준 크론(0=일…6=토)과 하루 어긋난다. `* * 6` 은 토요일이 아니라 일요일이다.
LOTTO_CRON=40,50 20 * * sat;0 21 * * sat

# 하루 4회(07·12·17·22시). 2026-09-08 에 매시간에서 줄였다.
# 새벽에는 신규 기사가 거의 없어 22시~07시를 비운다. 22시를 남기는 이유는
# 토요일 추첨(20:35) 직후 기사가 그 시간대에 몰리기 때문이다.
# 쿼터가 아니라 LLM 판정 비용과 무의미한 실행을 줄이려는 것이다.
NEWS_CRON=0 7,12,17,22 * * *

# lotto 잡이 '오류로' 죽었을 때의 재시도. 위 크론 3회와는 별개다.
# 크론 3회는 "결과가 아직 안 올라왔을 때"(0건 성공), 재시도는 "죽었을 때" 를 다룬다.
# 절대시각이 아니라 '몇 분 뒤' 로 둔다 — LOTTO_CRON 을 바꾸면 따라 움직여야 한다.
LOTTO_RETRY_DELAY_MIN=60
LOTTO_MAX_ATTEMPT=3

# ── 수동 트리거 인증 ────────────────────────────────────
# 비어 있으면 워커는 기동을 거부한다.  openssl rand -hex 32
WORKER_JOB_KEY=

# ── 네이버 검색 API (뉴스) ──────────────────────────────
# developers.naver.com 에서 애플리케이션 등록 → "검색" API 선택
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 쉼표 구분. '연금복권' 은 판정이 아니라 검색 커버리지 때문에 따로 던진다 —
# 주제 판정에서는 '복권' 이 '연금복권' 을 이미 부분문자열로 잡지만, 네이버는
# 질의어별로 다른 결과를 주므로 연금복권 기사가 '복권' 상위 50건 밖으로 밀릴 수 있다.
NAVER_NEWS_QUERY=로또,복권,연금복권
NAVER_NEWS_DISPLAY=50          # 최대 100. 일일 쿼터 25,000

# 발행일(KST)이 실행일로부터 이 일수보다 오래된 기사는 저장하지 않는다.
# sort=date 여도 네이버는 며칠 전 기사를 함께 준다.
# 2 = 오늘·어제·그제. 2026-09-08 에 1 에서 올렸다 — 하루 4회로 줄이며
# 22시~07시 아홉 시간 공백이 생겨, 1 이면 그 사이 자정을 넘긴 기사가
# 다음 실행에서 이미 '이틀 전' 이 되어 영영 안 들어온다.
NEWS_MAX_AGE_DAYS=2

# 검색 API 는 본문 전문을 뒤진다 — 기사 각주에 '복권기금' 이 한 줄 있는 과학관
# 보도자료도 결과에 들어온다. 실측 332건 중 67%가 제목에 검색어조차 없었다.
# 제목만이 기사의 주제를 말해 준다(요약은 검색어 주변 스니펫이라 변별력이 없다).
NEWS_TITLE_MUST_MATCH=true

# 제목에 이 낱말이 있으면 버린다. 부동산·증시가 '로또' 를 비유로 쓰는 문맥이다
# ('로또 청약', '로또 줍줍'). 새 유행어가 생기면 재배포 없이 여기에 더한다.
# 비우면 제외어 검사를 끈다.
NEWS_EXCLUDE_KEYWORDS=청약,줍줍,분양,무순위,입주,재건축,임대주택,임대,그린벨트,택지,아파트,부동산,억 로또,경쟁률,공모주,따상,주식,코인,적금,예금,반도체,사면·복권

# ── YouTube Data API (영상) ────────────────────────────
# console.cloud.google.com → 프로젝트 → YouTube Data API v3 활성화 → API 키 생성
# ★ 키에 "API 제한"을 걸어 YouTube Data API v3 만 허용한다. IP 제한은 걸지 않는다
#   (서버 IP 가 바뀌면 조용히 403 이 된다).
# 없으면 video_* 세 잡을 크론에 등록하지 않는다. lotto·news 는 정상 동작한다.
YOUTUBE_API_KEY=

# search.list 는 2026-06-01 부터 자체 쿼터 버킷이고 하루 100회가 상한이다.
# 네이버(25,000회)와 자릿수가 달라 매시간 크론이 불가능하다.
#   채널  3 units/회 × 4회 =  12 units
#   검색  4 calls/회 × 4회 =  16 calls / 100
#   갱신  1 unit/일
#   → 합계 약 20 units / 10,000 (0.2%)
# 토요일 야간 3회는 lotto 잡이 20:40·20:50·21:00 세 번 도는 것과 같은 논리다 —
# 추첨은 20:35~20:45 이고 실황·결과 영상은 21:00~22:30 에 몰린다.
YOUTUBE_CHANNEL_CRON=0 7,12,17,22 * * *
YOUTUBE_SEARCH_CRON=10 7,12,17,22 * * *
YOUTUBE_REFRESH_CRON=30 4 * * *

# 화이트리스트 채널(UC 로 시작). 2026-08-27 RSS 실측으로 확정한 공식 채널 둘.
#   UCEk3VwaA6e4H9TW1vSXOjDA = 동행복권 공식 (토=로또, 목=연금 당첨번호)
#   UCeyspQm90Le7EjROpj6rZXA = 알아볼권리 (MBC 로또·연금 방송 공식, 추첨 실황)
YOUTUBE_CHANNEL_KEY_LIST=UCEk3VwaA6e4H9TW1vSXOjDA,UCeyspQm90Le7EjROpj6rZXA

# 예상번호 제공 채널. 검색 경로로 새어 들어오는 것을 막는다.
YOUTUBE_BLOCK_CHANNEL_KEY_LIST=UC-uNAS6008_bFvbI4Nk-jcQ,UCWciziKWCdkqdoikWxo9fUw,UC-3zYni9OqS1nsR9blpspfA,UCWw2D-nV95cEoi-kR6nCfGg,UCQjUd_yvBYBadBTOfkmcESg,UCNoyjx2baN6rM2b7MjNg0lA,UCGd7y1IBVgTd26f1HSEHoWA

YOUTUBE_SEARCH_QUERY=로또 추첨,로또 당첨번호,연금복권 추첨,로또 판매점
YOUTUBE_SEARCH_MAX_RESULT=50
YOUTUBE_SEARCH_MAX_CALL_PER_RUN=4     # 질의 수와 일치시킨다
YOUTUBE_SEARCH_DAILY_BUDGET=60        # 100 중 60. 재시도·수동 트리거 여유
YOUTUBE_MAX_AGE_DAYS=7
YOUTUBE_TITLE_MUST_MATCH=true
YOUTUBE_EXCLUDE_KEYWORDS=청약,줍줍,분양,부동산,공모주,주식,코인

# ★ 금지 표현. forbidden-expressions.md 의 낱말을 수집 단계에서 막는다.
#   주제 제외어와 분리하는 이유는 '정책 때문에 몇 건이 걸렸는지' 를 따로 세기 위해서다.
YOUTUBE_FORBIDDEN_KEYWORDS=예상번호,추천번호,예측번호,예상수,추천수,제외수,궁합수,고정수,필출,고확률,당첨확률,적중률,1등예측,당첨보장,필승,비법,명당번호,천기누설,재물운,황금기운,신의한수,대박기운,행운의숫자,조합공식,조합기

YOUTUBE_SHORTS_MAX_SEC=180            # 쇼츠 공식 정의는 3분 이하
YOUTUBE_SUMMARY_MAX_LEN=300
YOUTUBE_DEDUPE_SAME_TITLE=true        # 같은 콘텐츠의 쇼츠판/롱폼판 중복 제거
YOUTUBE_REFRESH_AFTER_DAYS=25         # 30일 정책에 5일 버퍼
YOUTUBE_HARD_EXPIRE_DAYS=30           # 넘기면 API 성공 여부와 무관하게 삭제
YOUTUBE_RETAIN_DAYS=60                # 게시 60일 지난 영상은 갱신 없이 삭제
YOUTUBE_REFRESH_BATCH_LIMIT=500
YOUTUBE_MAX_RETRY=3
YOUTUBE_BACKOFF_BASE_SEC=2.0
YOUTUBE_DRY_RUN=false                 # true 면 DB 를 건드리지 않고 필터 통계만 로그로

# ── LLM 금지 표현 보조 판정 ────────────────────────────
# 규칙 제외어가 놓치는 신조어("필출 2수", "고정수 5")를 한 번 더 거른다.
# 생성이 아니라 분류다. 키가 없거나 API 가 죽으면 규칙 결과를 그대로 쓰고 경고만 남긴다.
# ★ 키 이름이 일반적이라 YOUTUBE_API_KEY 와 헷갈리기 쉽다 — 이쪽이 LLM 키다.
LLM=OPENAI                    # 현재 OPENAI 만 지원
MODEL=gpt-5-nano              # 입력 $0.05/1M · 출력 $0.40/1M (2026-08-28)
API_KEY=
LLM_JUDGE_ENABLED=true
LLM_JUDGE_BATCH_SIZE=20       # 한 요청에 묶을 영상 수
LLM_JUDGE_TIMEOUT_SEC=60.0   # 20건 배치가 20초를 넘는 경우가 있다
LLM_JUDGE_MAX_RETRY=2

# ── 서버 ───────────────────────────────────────────────
WORKER_HOST=127.0.0.1       # 루프백 고정. 0.0.0.0 으로 바꾸지 않는다
WORKER_PORT=8003
TZ=Asia/Seoul

# ── 수집 튜닝 (봇 감지 완화) ────────────────────────────
# 아래는 전부 기본값이 있다. 없어도 워커는 뜬다.
# 네이버가 요청 빈도에 민감해지면 재배포 없이 여기서 늦춘다.
CRAWL_DELAY_SEC=2.0             # 회차 간 대기
CRAWL_JITTER_SEC=0.8            # 위 값에 더할 무작위 지터 상한
CRAWL_MAX_RETRY=3
CRAWL_RETRY_DELAY_SEC=3.0
CRAWL_HTTP_TIMEOUT_SEC=10.0

# 뉴스 API 쿼터 초과(429) 대응 지수 백오프
NEWS_MAX_RETRY=3
NEWS_BACKOFF_BASE_SEC=2.0

# ── 잡 이력 정리 / catch-up ─────────────────────────────
STALE_RUNNING_HOURS=6           # 이 시간 넘긴 running 행을 기동 시 failed 로 정리
CATCH_UP_DAYS=7                 # lotto 마지막 성공이 이보다 오래면 기동 직후 1회 실행
