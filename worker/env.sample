# worker/.env_worker 의 템플릿.
#   cp env.sample .env_worker
# .env_worker 는 커밋하지 않는다. 명세: docs/wiki/10-contracts/env-vars.md
# 가상환경은 uv 가 관리한다 — uv sync / uv run / uv add. sudo 로 실행하지 않는다.

# ── Postgres (쓰기 롤) ──────────────────────────────────
# 개발 DB: WSL Docker 컨테이너 bskim-dev-pg18 (postgres:18)
PG_HOST=localhost
PG_PORT=5179                   # 컨테이너 5432 → 호스트 5179
PG_DB=prod_db                  # 이미 존재하는 DB. 소유자는 prod_user
PG_USER=app_writer
PG_PASSWORD=                   # worker/scripts/init_roles.sql 로 만든 비번

# ── 잡 스케줄 (KST). APScheduler CronTrigger 문법 ────────
# 코드에 박지 않는다. 추첨 시각이나 API 쿼터가 바뀌면 여기만 고친다.
#
# 여러 크론을 `;` 로 잇는다 → OrTrigger 로 합쳐진다. 잡은 여전히 하나다.
# 추첨 방송은 20:35 시작이고 번호 추첨이 끝나는 시각이 회차마다 다르다.
# 먼저 결과가 보이는 실행이 가져가고, 나머지는 0건 성공으로 끝난다.
#
# ★ 요일은 반드시 이름(sat)으로 쓴다. APScheduler 는 요일 숫자를 0=월…6=일 로 읽어
#   표준 크론(0=일…6=토)과 하루 어긋난다. `* * 6` 은 토요일이 아니라 일요일이다.
LOTTO_CRON=40,50 20 * * sat;0 21 * * sat

# 매시간. 일일 쿼터 25,000 중 검색어 2개 × 24회 = 48회(0.2%)만 쓴다.
# 신선도를 위한 것이지 누락 방지가 아니다 — 누락은 NEWS_MAX_AGE_DAYS 가 막는다.
NEWS_CRON=0 * * * *

# lotto 잡이 '오류로' 죽었을 때의 재시도. 위 크론 3회와는 별개다.
# 크론 3회는 "결과가 아직 안 올라왔을 때"(0건 성공), 재시도는 "죽었을 때" 를 다룬다.
# 절대시각이 아니라 '몇 분 뒤' 로 둔다 — LOTTO_CRON 을 바꾸면 따라 움직여야 한다.
LOTTO_RETRY_DELAY_MIN=60
LOTTO_MAX_ATTEMPT=3

# ── 수동 트리거 인증 ────────────────────────────────────
# 비어 있으면 워커는 기동을 거부한다.  openssl rand -hex 32
WORKER_JOB_KEY=

# ── 네이버 검색 API (뉴스) ──────────────────────────────
# developers.naver.com 에서 애플리케이션 등록 → "검색" API 선택
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_NEWS_QUERY=로또,복권      # 쉼표 구분
NAVER_NEWS_DISPLAY=50          # 최대 100. 일일 쿼터 25,000

# 발행일(KST)이 실행일로부터 이 일수보다 오래된 기사는 저장하지 않는다.
# sort=date 여도 네이버는 며칠 전 기사를 함께 준다.
# 1 = 오늘과 어제. 0(당일만)이면 자정 직전 발행 기사를 영영 놓친다.
NEWS_MAX_AGE_DAYS=1

# ── 서버 ───────────────────────────────────────────────
WORKER_HOST=127.0.0.1       # 루프백 고정. 0.0.0.0 으로 바꾸지 않는다
WORKER_PORT=8003
TZ=Asia/Seoul

# ── 수집 튜닝 (봇 감지 완화) ────────────────────────────
# 아래는 전부 기본값이 있다. 없어도 워커는 뜬다.
# 네이버가 요청 빈도에 민감해지면 재배포 없이 여기서 늦춘다.
CRAWL_DELAY_SEC=2.0             # 회차 간 대기
CRAWL_JITTER_SEC=0.8            # 위 값에 더할 무작위 지터 상한
CRAWL_MAX_RETRY=3
CRAWL_RETRY_DELAY_SEC=3.0
CRAWL_HTTP_TIMEOUT_SEC=10.0

# 뉴스 API 쿼터 초과(429) 대응 지수 백오프
NEWS_MAX_RETRY=3
NEWS_BACKOFF_BASE_SEC=2.0

# ── 잡 이력 정리 / catch-up ─────────────────────────────
STALE_RUNNING_HOURS=6           # 이 시간 넘긴 running 행을 기동 시 failed 로 정리
CATCH_UP_DAYS=7                 # lotto 마지막 성공이 이보다 오래면 기동 직후 1회 실행
