__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# 꿈해몽 임베딩 36MB. git 에 넣지 않는다 — 보관 방법은 아직 tbd
# (docs/wiki/00-decisions/0006-keep-chromadb-not-pgvector.md)
data/chroma_words/

# SQLite 는 Postgres 로 대체됐다. 코드는 더 이상 참조하지 않는다.
# data/lotto.db 만 예외로 남긴다 — 이미 커밋돼 있고 이관 원본이다.
data/*.db
!data/lotto.db
data/*.db-shm
data/*.db-wal

# .env 로 시작하는 파일은 전부 무시한다 (.env_backend 포함)
.env*
!env.sample

