# backend/.env_backend 의 템플릿.
#   cp env.sample .env_backend
# .env_backend 는 커밋하지 않는다. 명세: docs/wiki/10-contracts/env-vars.md
# 가상환경은 uv 가 관리한다 — uv sync / uv run / uv add. sudo 로 실행하지 않는다.


# ── Postgres (읽기 전용 롤) ─────────────────────────────
# app_writer 가 아니라 app_reader 다. 쓰기 비밀번호를 여기에 두지 않는다.
PG_HOST=localhost
PG_PORT=5179                   # 컨테이너 5432 → 호스트 5179
PG_DB=prod_db                  # 이미 존재하는 DB. 소유자는 prod_user
PG_USER=app_reader
PG_PASSWORD=   

# ── 꿈해몽 벡터 DB (읽기 전용) ──────────────────────────
CHROMA_DB_PATH=./data/chroma_words

# ── 서버 ───────────────────────────────────────────────
BACKEND_PORT=8005
CORS_ORIGINS=http://localhost:3000
TZ=Asia/Seoul

# ── 몬테카를로 추천 동시 실행 수 ────────────────────────
# strategy=ensemble 추천은 5만 회 시뮬레이션을 돈다. 이 계산은 동시에 돌릴수록
# 느려진다(2건 6.5배, 4건 24.8배 실측). 작은 numpy 호출이 GIL 을 놓았다 잡기를
# 반복하며 스레드끼리 손바꿈에 시간을 쓰기 때문이고, 어차피 GIL 아래에서는
# 총 처리량이 하나분이라 동시 실행의 이득이 0 이다. 평상시에 올리지 않는다.
# 근거: docs/wiki/00-decisions/0012-serialize-monte-carlo.md
# 없어도 기동한다(기본 1). 0 이하면 기동을 거부한다.
RECOMMEND_MAX_CONCURRENCY=1

# 백엔드에는 WORKER_JOB_KEY 가 없다. 백엔드는 워커를 부르지 않는다.
