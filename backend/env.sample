# backend/.env_backend 의 템플릿.
#   cp env.sample .env_backend
# .env_backend 는 커밋하지 않는다. 명세: docs/wiki/10-contracts/env-vars.md
# 가상환경은 uv 가 관리한다 — uv sync / uv run / uv add. sudo 로 실행하지 않는다.


# ── Postgres (읽기 전용 롤) ─────────────────────────────
# app_writer 가 아니라 app_reader 다. 쓰기 비밀번호를 여기에 두지 않는다.
PG_HOST=localhost
PG_PORT=5179                   # 컨테이너 5432 → 호스트 5179
PG_DB=prod_db                  # 이미 존재하는 DB. 소유자는 prod_user
PG_USER=app_reader
PG_PASSWORD=   

# ── 꿈해몽 벡터 DB (읽기 전용) ──────────────────────────
CHROMA_DB_PATH=./data/chroma_words

# ── 서버 ───────────────────────────────────────────────
BACKEND_PORT=8005
# 브라우저가 통계 API 를 직접 부른다(003 CSR). 오리진은 문자 그대로 비교되므로
# localhost 와 127.0.0.1 은 서로 다른 값이다 — 쓰는 주소를 전부 나열한다.
# 빠뜨리면 서버는 200 을 주는데 브라우저만 조용히 막는다(서버 로그에 안 보인다).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TZ=Asia/Seoul

# ── 몬테카를로 추천 동시 실행 수 ────────────────────────
# strategy=ensemble 추천은 5만 회 시뮬레이션을 돈다. 이 계산은 동시에 돌릴수록
# 느려진다(2건 6.5배, 4건 24.8배 실측). 작은 numpy 호출이 GIL 을 놓았다 잡기를
# 반복하며 스레드끼리 손바꿈에 시간을 쓰기 때문이고, 어차피 GIL 아래에서는
# 총 처리량이 하나분이라 동시 실행의 이득이 0 이다. 평상시에 올리지 않는다.
# 근거: docs/wiki/00-decisions/0012-serialize-monte-carlo.md
# 없어도 기동한다(기본 1). 0 이하면 기동을 거부한다.
RECOMMEND_MAX_CONCURRENCY=1

# ── 운영자 전용 화면 (/admin) — 아이디 + 비밀번호 + OTP ──
# 아래 다섯 값은 손으로 만들지 않는다. 이 명령이 전부 만들어 준다.
#
#   uv run python scripts/make_admin_credentials.py
#
# 아이디와 비밀번호를 물어본 뒤 해시·OTP 비밀키·서명키를 출력하고,
# 인증 앱(Microsoft Authenticator 등)으로 찍을 QR 을 터미널에 그린다.
#
# ★ 하나라도 비면 /api/admin/* 가 전부 503 을 낸다. 빈 문자열끼리 compare_digest
#   비교는 통과하므로, 빈 값을 '인증 없음'으로 두면 아무나 들어온다 —
#   인증이 없는 것보다 나쁘다(있다고 착각하게 만든다).
# ★ 특히 ADMIN_TOTP_SECRET 이 없다고 비밀번호만으로 통과시키지 않는다.
#   2단계를 켰다고 믿는 사람에게 1단계만 돌려주는 것이 가장 나쁜 실패다.
ADMIN_USERNAME=
# 비밀번호 **원문을 두지 않는다.** scrypt$n$r$p$salt$hash 형식의 해시다.
ADMIN_PASSWORD_HASH=
# TOTP(RFC 6238) 비밀키(base32). 인증 앱이 이 값으로 30초마다 여섯 자리를 만든다.
ADMIN_TOTP_SECRET=
# 세션 쿠키 서명 키. 위 값들과 **다른 값**이어야 한다 —
# 같으면 쿠키에서 자격증명을 역산할 여지가 생긴다. 같은 값이면 기동을 거부한다.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=12
# ★ 운영(HTTPS)에서는 반드시 true 로 바꾼다.
#   브라우저는 프론트(Next)와만 말하고 Next 서버가 백엔드를 중계하므로, 백엔드에
#   닿는 요청은 내부망 평문 HTTP 다 — 사용자가 HTTPS 를 써도 백엔드는 알 수 없다.
#   그래서 사람이 명시한다. 로컬 http 에서 true 면 브라우저가 쿠키를 저장하지 않아
#   로그인이 조용히 실패하므로 기본은 false 다.
ADMIN_COOKIE_SECURE=false

# 백엔드에는 WORKER_JOB_KEY 가 없다. 백엔드는 워커를 부르지 않는다.
